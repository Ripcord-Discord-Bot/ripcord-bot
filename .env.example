# API
API_PORT=3001
PANEL_ORIGIN=http://localhost:5173
API_TOKEN=change-me

# Bot
DISCORD_TOKEN=TOKEN
COMMAND_PREFIX=!
SERVER_TITLE=Ripcord
TEXT_CHANNELS_CATEGORY=text channels

# Logging
ENABLE_CONSOLE=true
ENABLE_FILE_LOGGING=true
LOGS_PATH=logs

# Channels
CHAT_CHANNEL=chat
MODERATOR_CHANNEL=moderators
TICKET_CHANNEL=issues
WELCOME_CHANNEL=welcome

# Roles
MODERATOR_ROLE=Moderator
TRUSTED_ROLE=Trusted

# Filtering
ENABLE_FILTERING=true
FILTERED_WORDS_DIR=data
FILTERED_WORDS_FILE=filtered-words.json

# AI
OLLAMA_MODEL=mistral

# Tickets
ENABLE_TICKETS=true
TICKET_DIRECTORY_PATH=tickets

# Onboarding
ENABLE_ONBOARDING=true

# Scheduler
SCHEDULES_PATH=data
SCHEDULES_FILE=schedules.json

# Persistence
AUTO_KICKER_PATH=data
AUTO_KICKER_FILE=kicked-users.json
BANNED_USERS_PATH=data
BANNED_USERS_FILE=banned-users.json
SERVER_RULES_ID_PATH=data
SERVER_RULES_ID_FILE=server-rules-id.json
SERVER_STATS_PATH=data
SERVER_STATS_FILE=server-stats.json
CATEGORY_TITLE_ID_PATH=data
CATEGORY_TITLE_ID_FILE=category-title-id.json

# Invites
INVITES_PATH=data
INVITES_FILE=invites.json